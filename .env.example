# Server
PORT=4000
# Comma-separated origins allowed to call the API (website + admin dashboard). Use * to allow all.
CORS_ORIGINS=http://localhost:3000,http://localhost:3030,http://localhost:8080

# MySQL (the database is created automatically if it does not exist)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio
# Auto-create/alter tables from the entities (keep true for development)
DB_SYNC=true

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
# Refresh tokens (sessions) last 7 days and slide forward on every use
REFRESH_TOKEN_TTL_DAYS=7
# Refresh-token cookie for the website and dashboard. Use COOKIE_SECURE=true on HTTPS;
# COOKIE_SAMESITE=none (requires HTTPS) only if the site and API are on different domains.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# First admin account, created on first boot when no users exist
ADMIN_EMAIL=admin@portfolio.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Gopi

# Public URL of this API (used to build absolute links to uploaded files)
PUBLIC_URL=http://localhost:4000

# Every content change rewrites the offline snapshot to these files (comma-separated, relative to BACKEND/)
# so the static website shows the exact latest data even when this API or MySQL is down.
SNAPSHOT_PATHS=../WEBSITE/public/site-data.json,../WEBSITE/src/data/site-snapshot.json,../WEBSITE/out/site-data.json
